@using System.Security.Claims
<header class="header-1">
<div class="div-1">
<a href="/" class="a-1">
<span class="span-1">LOGO</span>
<span class="span-2">VoyageVista</span>
</a>
<nav aria-label="Hoofdmenu" class="nav-1">
<a href="/bestemmingen" class="a-2 @(Active ? "nav-active" : "")">Bestemmingen</a>
<a href="/bestemmingen" class="a-2">Reisvormen</a>
<a href="/bestemmingen" class="a-2">Aanbiedingen</a>
<a href="/mijn-reizen" class="a-2">Klantenservice</a>
</nav>
<div class="div-2">
<AuthorizeView>
<Authorized>
<a href="/mijn-reizen" class="a-3">Mijn reizen</a>
<span class="span-3">@context.User.FindFirst(ClaimTypes.GivenName)?.Value?[..1]</span>
<span class="span-4">@context.User.FindFirst(ClaimTypes.GivenName)?.Value</span>
<form method="post" action="/auth/logout" class="form-1">
<AntiforgeryToken />
<button type="submit" class="button-1">Uitloggen</button>
</form>
</Authorized>
<NotAuthorized>
<a href="/auth/login" class="a-4">Inloggen</a>
</NotAuthorized>
</AuthorizeView>
</div>
</div>
</header>

@code {
    [Parameter] public bool Active { get; set; }
}
