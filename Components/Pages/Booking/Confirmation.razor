@page "/boeken/bevestiging"

<PageTitle>VoyageVista – Boeking bevestigd</PageTitle>

<ConfirmHeader />

<main style="max-width: 880px; margin: 0 auto; padding: 56px 32px 72px; display: flex; flex-direction: column; gap: 28px">
<div style="display: flex; flex-direction: column; align-items: center; text-align: center; gap: 14px">
<span aria-hidden="true" style="width: 72px; height: 72px; border-radius: 50%; background: var(--success-bg); color: var(--success); display: flex; align-items: center; justify-content: center; font-size: 34px; font-weight: 700">✓</span>
<h1 style="margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 40px">Je reis naar Mars is geboekt!</h1>
<p style="margin: 0; color: var(--muted); font-size: 17px">Boekingsnummer <strong style="color: var(--ink)">[VV-000000]</strong> · bevestiging verstuurd naar [E-MAILADRES]</p>
</div>

<section style="border: 1px solid var(--line); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 16px">
<h2 style="margin: 0; font-size: 20px">Wat gebeurt er nu?</h2>
<ol style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 14px">
<li style="display: flex; gap: 14px; align-items: flex-start"><span style="width: 32px; height: 32px; flex: none; border-radius: 50%; background: var(--success); color: var(--white); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700">✓</span><span><strong>Betaling ontvangen</strong><br><span style="font-size: 14px; color: var(--muted)">Factuur staat in je account en is gemaild.</span></span></li>
<li style="display: flex; gap: 14px; align-items: flex-start"><span style="width: 32px; height: 32px; flex: none; border-radius: 50%; background: var(--brand); color: var(--white); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700">2</span><span><strong>Gezondheidscheck plannen</strong><br><span style="font-size: 14px; color: var(--muted)">Uiterlijk [DATUM] – je krijgt een uitnodiging.</span></span></li>
<li style="display: flex; gap: 14px; align-items: flex-start"><span style="width: 32px; height: 32px; flex: none; border-radius: 50%; border: 2px solid var(--subtle); color: var(--muted); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700">3</span><span><strong>Reisdocumenten</strong><br><span style="font-size: 14px; color: var(--muted)">[X] weken voor vertrek in Mijn reizen.</span></span></li>
<li style="display: flex; gap: 14px; align-items: flex-start"><span style="width: 32px; height: 32px; flex: none; border-radius: 50%; border: 2px solid var(--subtle); color: var(--muted); display: flex; align-items: center; justify-content: center; font-size: 14px; font-weight: 700">4</span><span><strong>Vertrek</strong><br><span style="font-size: 14px; color: var(--muted)">[DATUM] vanaf [LANCEERBASIS]</span></span></li>
</ol>
</section>

<div style="display: flex; flex-wrap: wrap; gap: 12px; justify-content: center">
<a href="/mijn-reizen" style="background: var(--brand); color: var(--white); text-decoration: none; padding: 14px 22px; border-radius: 10px; font-weight: 600">Naar mijn reizen</a>
</div>

</main>


