@page "/boeken/gegevens"

<PageTitle>VoyageVista – Reizigersgegevens</PageTitle>

@@<CheckoutHeader />@@

<nav aria-label="Boekingsstappen" style="background: #EEF3FB">
<ol style="max-width: 1280px; margin: 0 auto; padding: 18px 32px; list-style: none; display: flex; flex-wrap: wrap; gap: 12px 28px; font-size: 14px">
<li style="display: flex; gap: 8px; align-items: center; color: #1D5C3A; font-weight: 600"><span style="width: 28px; height: 28px; border-radius: 50%; background: #1D5C3A; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 13px">✓</span>Reis kiezen</li>
<li style="display: flex; gap: 8px; align-items: center; color: #1D5C3A; font-weight: 600"><span style="width: 28px; height: 28px; border-radius: 50%; background: #1D5C3A; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 13px">✓</span>Samenstellen</li>
<li aria-current="step" style="display: flex; gap: 8px; align-items: center; font-weight: 700"><span style="width: 28px; height: 28px; border-radius: 50%; background: #5A3FD1; color: #FFFFFF; display: flex; align-items: center; justify-content: center; font-size: 13px">3</span>Gegevens</li>
<li style="display: flex; gap: 8px; align-items: center; color: #55607A"><span style="width: 28px; height: 28px; border-radius: 50%; border: 2px solid #8C95AD; display: flex; align-items: center; justify-content: center; font-size: 13px">4</span>Betalen</li>
<li style="display: flex; gap: 8px; align-items: center; color: #55607A"><span style="width: 28px; height: 28px; border-radius: 50%; border: 2px solid #8C95AD; display: flex; align-items: center; justify-content: center; font-size: 13px">5</span>Bevestiging</li>
</ol>
</nav>

<main style="max-width: 1280px; margin: 0 auto; padding: 32px; display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start">
<form aria-label="Reizigersgegevens" style="flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 28px">
<h1 style="margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 32px">Wie gaan er mee?</h1>

<div style="background: #EEF3FB; border-radius: 14px; padding: 16px 20px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px">
<span>Heb je al een account? Dan vullen we je gegevens in.</span>
<button type="button" style="background: #16163F; color: #FFFFFF; border: 0; padding: 12px 18px; border-radius: 10px; font-weight: 600; font-family: inherit; font-size: 15px">Inloggen</button>
</div>

@if (_fouten) {
<div role="alert" style="border: 2px solid #B42318; background: #FEF3F2; border-radius: 12px; padding: 14px 18px; color: #7A1A12; font-size: 15px"><strong>Controleer 2 velden.</strong> Verplichte velden zijn gemarkeerd met *.</div>
}

<fieldset style="border: 1px solid #E3E7F0; border-radius: 16px; padding: 20px; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px">
<legend style="font-weight: 700; font-size: 18px; padding: 0 6px">Hoofdreiziger</legend>
<label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600">Voornaam *<input type="text" value="Sanne" style="height: 48px; border: 1px solid #C9D1E3; border-radius: 10px; padding: 0 12px; font-size: 15px; font-family: inherit"></label>
<label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600">Achternaam *<input type="text" style="@VeldStijl">
@if (_fouten) {<span style="color: #B42318; font-weight: 500">Vul je achternaam in.</span>}</label>
<label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600">Geboortedatum *<input type="text" placeholder="dd-mm-jjjj" style="height: 48px; border: 1px solid #C9D1E3; border-radius: 10px; padding: 0 12px; font-size: 15px; font-family: inherit"></label>
<label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600">E-mailadres *<input type="email" value="sanne@@voorbeeld" style="@VeldStijl">
@if (_fouten) {<span style="color: #B42318; font-weight: 500">Vul een geldig e-mailadres in, bijv. naam@@voorbeeld.nl</span>}</label>
<label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600">Telefoonnummer<input type="tel" style="height: 48px; border: 1px solid #C9D1E3; border-radius: 10px; padding: 0 12px; font-size: 15px; font-family: inherit"></label>
<label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600">Postcode + huisnummer *<input type="text" style="height: 48px; border: 1px solid #C9D1E3; border-radius: 10px; padding: 0 12px; font-size: 15px; font-family: inherit"></label>
</fieldset>

<fieldset style="border: 1px solid #E3E7F0; border-radius: 16px; padding: 20px; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px">
<legend style="font-weight: 700; font-size: 18px; padding: 0 6px">Reiziger 2</legend>
<label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600">Voornaam *<input type="text" style="height: 48px; border: 1px solid #C9D1E3; border-radius: 10px; padding: 0 12px; font-size: 15px; font-family: inherit"></label>
<label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600">Achternaam *<input type="text" style="height: 48px; border: 1px solid #C9D1E3; border-radius: 10px; padding: 0 12px; font-size: 15px; font-family: inherit"></label>
<label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600">Geboortedatum *<input type="text" placeholder="dd-mm-jjjj" style="height: 48px; border: 1px solid #C9D1E3; border-radius: 10px; padding: 0 12px; font-size: 15px; font-family: inherit"></label>
</fieldset>

<fieldset style="border: 1px solid #E3E7F0; border-radius: 16px; padding: 20px; margin: 0; display: flex; flex-direction: column; gap: 12px; font-size: 15px">
<legend style="font-weight: 700; font-size: 18px; padding: 0 6px">Gezondheid &amp; veiligheid</legend>
<label style="display: flex; gap: 10px; align-items: flex-start"><input type="checkbox"> Alle reizigers verklaren fit genoeg te zijn voor deze reisvorm (verplicht bij raket) *</label>
<a href="/reis" style="font-size: 14px">Lees de gezondheidseisen per reisvorm</a>
</fieldset>

<fieldset style="border: 1px solid #E3E7F0; border-radius: 16px; padding: 20px; margin: 0; display: flex; flex-direction: column; gap: 12px; font-size: 15px">
<legend style="font-weight: 700; font-size: 18px; padding: 0 6px">Voorkeuren (optioneel)</legend>
<label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600; max-width: 360px">Hoe heb je ons gevonden?
<select style="height: 48px; border: 1px solid #C9D1E3; border-radius: 10px; padding: 0 12px; font-family: inherit; font-size: 15px; background: #FFFFFF; color: #16163F"><option>Maak een keuze</option><option>Instagram / TikTok</option><option>Influencer</option><option>Vrienden</option><option>Nieuwsbrief</option><option>Zoekmachine</option></select></label>
<label style="display: flex; gap: 10px; align-items: flex-start"><input type="checkbox"> Account aanmaken om boekingen, facturen en vragen te bekijken</label>
<label style="display: flex; gap: 10px; align-items: flex-start"><input type="checkbox"> Ik wil persoonlijke reisaanbiedingen ontvangen per e-mail</label>
</fieldset>

<div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px">
<a href="/boeken/samenstellen" style="border: 1px solid #C9D1E3; color: #16163F; text-decoration: none; padding: 14px 22px; border-radius: 10px; font-weight: 600">Terug</a>
<a href="/boeken/betalen" style="background: #5A3FD1; color: #FFFFFF; text-decoration: none; padding: 14px 22px; border-radius: 10px; font-weight: 600">Verder naar betalen</a>
</div>
</form>

<aside aria-label="Jouw reis" style="flex: 1 1 320px; border: 1px solid #C9D1E3; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 12px">
<h2 style="margin: 0; font-size: 18px">Jouw reis</h2>
<p style="margin: 0; font-weight: 700">Mars Basecamp Expeditie</p>
<p style="margin: 0; font-size: 14px; color: #55607A">[DATUM] · 7 dagen · 2 reizigers · Raket</p>
<div style="border-top: 1px solid #E3E7F0; padding-top: 12px; display: flex; justify-content: space-between; font-weight: 700; font-size: 18px"><span>Totaal</span><span>[TOTAAL]</span></div>
<p style="margin: 0; font-size: 13px; color: #55607A">Je gegevens worden alleen gebruikt voor deze boeking, tenzij je hierboven toestemming geeft.</p>
</aside>
</main>


@code {
    private bool _fouten = true;

    private const string Basis = "height: 48px; border-radius: 10px; padding: 0 12px; font-size: 15px; font-family: inherit; ";

    private string VeldStijl => Basis + (_fouten ? "border: 2px solid #B42318" : "border: 1px solid #C9D1E3");
}
