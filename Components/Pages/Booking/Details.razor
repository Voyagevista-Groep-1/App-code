@page "/boeken/gegevens"

<PageTitle>VoyageVista – Reizigersgegevens</PageTitle>

<CheckoutHeader />

<nav aria-label="Boekingsstappen" class="nav-1">
<ol class="ol-1">
<li class="li-1"><span class="span-1">✓</span>Reis kiezen</li>
<li class="li-1"><span class="span-1">✓</span>Samenstellen</li>
<li aria-current="step" class="li-2"><span class="span-2">3</span>Gegevens</li>
<li class="li-3"><span class="span-3">4</span>Betalen</li>
<li class="li-3"><span class="span-3">5</span>Bevestiging</li>
</ol>
</nav>

<main class="main-1 flow">
<form aria-label="Reizigersgegevens" novalidate @onsubmit="Verder" class="form-1">
<h1 class="h1-1">Wie gaan er mee?</h1>

@if (!_ingelogd) {
<div class="div-1">
<span>Heb je al een account? Dan vullen we je gegevens in.</span>
<a href="/auth/login?returnUrl=/boeken/gegevens" class="a-1">Inloggen</a>
</div>
}

@if (_fouten.Count > 0) {
<div role="alert" class="div-2"><strong>Controleer @_fouten.Count @(_fouten.Count == 1 ? "veld" : "velden").</strong> Verplichte velden zijn gemarkeerd met *.</div>
}

<fieldset class="fieldset-1">
<legend class="legend-1">Hoofdreiziger</legend>
<label class="label-1">Voornaam *<input type="text" @bind="_voornaam" name="voornaam" autocomplete="given-name" maxlength="50" required class="@Klasse("voornaam")">@Fout("voornaam")</label>
<label class="label-1">Achternaam *<input type="text" @bind="_achternaam" name="achternaam" autocomplete="family-name" maxlength="50" required class="@Klasse("achternaam")">@Fout("achternaam")</label>
<label class="label-1">Geboortedatum *<input type="date" @bind="_geboorte" name="geboorte" autocomplete="bday" min="1900-01-01" max="@Vandaag" required class="@Klasse("geboorte")">@Fout("geboorte")</label>
<label class="label-1">E-mailadres *<input type="email" @bind="_email" name="email" autocomplete="email" maxlength="200" required class="@Klasse("email")">@Fout("email")</label>
<label class="label-1">Telefoonnummer<input type="tel" @bind="_telefoon" name="telefoon" autocomplete="tel" maxlength="20" pattern="[+0-9 ()\-]{8,20}" class="@Klasse("telefoon")">@Fout("telefoon")</label>
<label class="label-1">Postcode *<input type="text" @bind="_postcode" name="postcode" autocomplete="postal-code" maxlength="7" required pattern="[1-9][0-9]{3} ?[A-Za-z]{2}" placeholder="1234 AB" class="@Klasse("postcode")">@Fout("postcode")</label>
<label class="label-1">Huisnummer *<input type="text" @bind="_huisnummer" name="huisnummer" autocomplete="address-line2" maxlength="10" required pattern="[0-9]+[A-Za-z0-9 \-]*" placeholder="12" class="@Klasse("huisnummer")">@Fout("huisnummer")</label>
</fieldset>

<fieldset class="fieldset-1">
<legend class="legend-1">Reiziger 2</legend>
<label class="label-1">Voornaam *<input type="text" @bind="_voornaam2" name="voornaam2" maxlength="50" required class="@Klasse("voornaam2")">@Fout("voornaam2")</label>
<label class="label-1">Achternaam *<input type="text" @bind="_achternaam2" name="achternaam2" maxlength="50" required class="@Klasse("achternaam2")">@Fout("achternaam2")</label>
<label class="label-1">Geboortedatum *<input type="date" @bind="_geboorte2" name="geboorte2" min="1900-01-01" max="@Vandaag" required class="@Klasse("geboorte2")">@Fout("geboorte2")</label>
</fieldset>

<fieldset class="fieldset-2">
<legend class="legend-1">Gezondheid &amp; veiligheid</legend>
<label class="label-2"><input type="checkbox" @bind="_fit" name="fit" required> Alle reizigers verklaren fit genoeg te zijn voor deze reisvorm (verplicht bij raket) *@Fout("fit")</label>
<a href="/reis" class="a-2">Lees de gezondheidseisen per reisvorm</a>
</fieldset>

<fieldset class="fieldset-2">
<legend class="legend-1">Voorkeuren (optioneel)</legend>
<label class="label-3">Hoe heb je ons gevonden?
<select @bind="_bron" name="bron" class="select-1"><option value="">Maak een keuze</option><option>Instagram / TikTok</option><option>Influencer</option><option>Vrienden</option><option>Nieuwsbrief</option><option>Zoekmachine</option></select></label>
@if (!_ingelogd) {<label class="label-2"><input type="checkbox" @bind="_account"> Account aanmaken om boekingen, facturen en vragen te bekijken</label>}
<label class="label-2"><input type="checkbox" @bind="_aanbiedingen"> Ik wil persoonlijke reisaanbiedingen ontvangen per e-mail</label>
</fieldset>

<div class="div-3">
<a href="/boeken/samenstellen" class="a-3">Terug</a>
<button type="submit" class="button-1">Verder naar betalen</button>
</div>
</form>

<aside aria-label="Jouw reis" class="aside-1">
<h2 class="h2-1">Jouw reis</h2>
<p class="p-1">Mars Basecamp Expeditie</p>
<p class="p-2">[DATUM] · 7 dagen · 2 reizigers · Raket</p>
<div class="div-4"><span>Totaal</span><span>[TOTAAL]</span></div>
<p class="p-3">Je gegevens worden alleen gebruikt voor deze boeking, tenzij je hierboven toestemming geeft.</p>
</aside>
</main>


@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation

@code {
    private string _voornaam = "", _achternaam = "", _email = "", _telefoon = "", _postcode = "", _huisnummer = "", _bron = "";
    private string _voornaam2 = "", _achternaam2 = "";
    private DateTime? _geboorte, _geboorte2;
    private bool _fit, _account, _aanbiedingen, _ingelogd;
    private readonly Dictionary<string, string> _fouten = [];

    private static string Vandaag => DateTime.Today.ToString("yyyy-MM-dd");
    private string Klasse(string veld) => _fouten.ContainsKey(veld) ? "invalid" : "";

    private RenderFragment Fout(string veld) => @<text>@if (_fouten.TryGetValue(veld, out var melding)) {<span class="field-error">@melding</span>}</text>;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _ingelogd = true;
            _voornaam = user.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "";
            _achternaam = user.FindFirst(System.Security.Claims.ClaimTypes.Surname)?.Value ?? "";
            _email = user.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value ?? "";
        }
    }

    private static bool Naam(string v) => !string.IsNullOrWhiteSpace(v) && v.Trim().Length <= 50;
    private static bool Geboorte(DateTime? d) => d is { } x && x.Date <= DateTime.Today && x.Year >= 1900;

    private void Verder()
    {
        _fouten.Clear();
        if (!Naam(_voornaam)) _fouten["voornaam"] = "Vul je voornaam in.";
        if (!Naam(_achternaam)) _fouten["achternaam"] = "Vul je achternaam in.";
        if (!Geboorte(_geboorte)) _fouten["geboorte"] = "Vul een geldige geboortedatum in.";
        if (!AuthService.IsValidEmail(_email)) _fouten["email"] = "Vul een geldig e-mailadres in, bijv. naam@voorbeeld.nl";
        if (!string.IsNullOrWhiteSpace(_telefoon) && !System.Text.RegularExpressions.Regex.IsMatch(_telefoon, @"^[+0-9 ()\-]{8,20}$")) _fouten["telefoon"] = "Vul een geldig telefoonnummer in.";
        if (!System.Text.RegularExpressions.Regex.IsMatch(_postcode.Trim(), @"^[1-9][0-9]{3} ?[A-Za-z]{2}$")) _fouten["postcode"] = "Vul een geldige postcode in, bijv. 5745 FG of 5745FG.";
        if (!System.Text.RegularExpressions.Regex.IsMatch(_huisnummer.Trim(), @"^[0-9]+[A-Za-z0-9 \-]{0,9}$")) _fouten["huisnummer"] = "Vul een geldig huisnummer in, bijv. 12 of 12A.";
        if (!Naam(_voornaam2)) _fouten["voornaam2"] = "Vul de voornaam van reiziger 2 in.";
        if (!Naam(_achternaam2)) _fouten["achternaam2"] = "Vul de achternaam van reiziger 2 in.";
        if (!Geboorte(_geboorte2)) _fouten["geboorte2"] = "Vul een geldige geboortedatum in.";
        if (!_fit) _fouten["fit"] = "Bevestig dat alle reizigers fit genoeg zijn.";

        if (_fouten.Count == 0)
        {
            Navigation.NavigateTo("/boeken/betalen");
        }
    }
}
