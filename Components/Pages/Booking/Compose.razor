@page "/boeken/samenstellen"

<PageTitle>VoyageVista – Reis samenstellen</PageTitle>

<CheckoutHeader />

<nav aria-label="Boekingsstappen" class="nav-1">
<ol class="ol-1">
<li class="li-1"><span class="span-1">✓</span>Reis kiezen</li>
<li aria-current="step" class="li-2"><span class="span-2">2</span>Samenstellen</li>
<li class="li-3"><span class="span-3">3</span>Gegevens</li>
<li class="li-3"><span class="span-3">4</span>Betalen</li>
<li class="li-3"><span class="span-3">5</span>Bevestiging</li>
</ol>
</nav>

<main class="main-1">
<div class="div-1">
<h1 class="h1-1">Stel je reis samen</h1>

<section class="section-1">
<h2 class="h2-1">1. Kies je reisvorm</h2>
<div class="div-2">
@foreach (var v in Vormen) {
<button type="button" @onclick="() => _gekozen = v" aria-pressed="@(v == _gekozen ? "true" : "false")" class="vorm-kaart @(v == _gekozen ? "gekozen" : "")">
<span class="span-4">ICOON</span>
<span class="span-5">@(v.Naam)</span>
<span class="span-6">Reistijd: @(v.Tijd)</span>
<span class="span-6">Comfort: @(v.Comfort)</span>
<span class="span-7">@(v.Prijs)</span>
</button>
}
</div>
<p class="p-1">Reisvormen komen uit de catalogus; een nieuwe vorm verschijnt hier zonder schermaanpassing.</p>
</section>

<section class="section-1">
<h2 class="h2-1">2. Kies je verblijf</h2>
<div class="div-3">
<label class="label-1"><input type="radio" name="verblijf" checked><span class="span-8"></span><span class="span-9"><strong>Basecamp Dome</strong><br><span class="span-10">Standaard · gedeelde faciliteiten</span></span><span class="span-11">inbegrepen</span></label>
<label class="label-2"><input type="radio" name="verblijf"><span class="span-8"></span><span class="span-9"><strong>Crater View Suite</strong><br><span class="span-10">Privé · uitzicht op krater</span></span><span class="span-11">+ [PRIJS]</span></label>
</div>
</section>

<section class="section-1">
<h2 class="h2-1">3. Activiteiten &amp; extra’s</h2>
<div class="div-4">
<label class="label-3"><span class="span-12"><input type="checkbox"> Rover-tocht Olympus Mons</span><span>+ [PRIJS]</span></label>
<label class="label-3"><span class="span-12"><input type="checkbox"> Ruimtewandeling</span><span>+ [PRIJS]</span></label>
<label class="label-3"><span class="span-12"><input type="checkbox"> Annuleringsverzekering</span><span>+ [PRIJS]</span></label>
<label class="label-3"><span class="span-12"><input type="checkbox"> Ruimtereisverzekering</span><span>+ [PRIJS]</span></label>
</div>
</section>

<div class="div-5">
<a href="/reis" class="a-1">Terug</a>
<a href="/boeken/gegevens" class="a-2">Verder naar gegevens</a>
</div>
</div>

<aside aria-label="Jouw reis" class="aside-1">
<h2 class="h2-2">Jouw reis</h2>
<div class="div-6"></div>
<p class="p-2">Mars Basecamp Expeditie</p>
<p class="p-3">[DATUM] · 7 dagen · 2 reizigers</p>
<div class="div-7">
<div class="div-8"><span>Basisreis × 2</span><span>[PRIJS]</span></div>
<div class="div-8"><span>Reisvorm: @(_gekozen.Naam)</span><span>@(_gekozen.Prijs)</span></div>
<div class="div-8"><span>Verblijf</span><span>inbegrepen</span></div>
<div class="div-8"><span>Extra’s</span><span>[PRIJS]</span></div>
</div>
<div class="div-9"><span>Totaal</span><span>[TOTAAL]</span></div>
<p class="p-4">Prijs gegarandeerd tot [TIJDSTIP]</p>
</aside>
</main>


@code {
    private record VormenItem(string Id, string Naam, string Tijd, string Comfort, string Prijs);

    private static readonly VormenItem[] Vormen =
    [
        new("raket", "Raket", "[X] dagen", "Basis", "inbegrepen"),
        new("tele", "Teleportatie", "direct", "Hoog", "+ [PRIJS]"),
        new("cruise", "Vliegend cruiseschip", "[X] dagen", "Luxe", "+ [PRIJS]"),
        new("vr", "VR Experience", "n.v.t.", "Thuis", "– [KORTING]"),
    ];

    private VormenItem _gekozen = Vormen[0];

}
