@page "/boeken/samenstellen"

<PageTitle>VoyageVista – Reis samenstellen</PageTitle>

<CheckoutHeader />

<nav aria-label="Boekingsstappen" style="background: var(--surface)">
<ol style="max-width: 1280px; margin: 0 auto; padding: 18px 32px; list-style: none; display: flex; flex-wrap: wrap; gap: 12px 28px; font-size: 14px">
<li style="display: flex; gap: 8px; align-items: center; color: var(--success); font-weight: 600"><span style="width: 28px; height: 28px; border-radius: 50%; background: var(--success); color: var(--white); display: flex; align-items: center; justify-content: center; font-size: 13px">✓</span>Reis kiezen</li>
<li aria-current="step" style="display: flex; gap: 8px; align-items: center; font-weight: 700"><span style="width: 28px; height: 28px; border-radius: 50%; background: var(--brand); color: var(--white); display: flex; align-items: center; justify-content: center; font-size: 13px">2</span>Samenstellen</li>
<li style="display: flex; gap: 8px; align-items: center; color: var(--muted)"><span style="width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--subtle); display: flex; align-items: center; justify-content: center; font-size: 13px">3</span>Gegevens</li>
<li style="display: flex; gap: 8px; align-items: center; color: var(--muted)"><span style="width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--subtle); display: flex; align-items: center; justify-content: center; font-size: 13px">4</span>Betalen</li>
<li style="display: flex; gap: 8px; align-items: center; color: var(--muted)"><span style="width: 28px; height: 28px; border-radius: 50%; border: 2px solid var(--subtle); display: flex; align-items: center; justify-content: center; font-size: 13px">5</span>Bevestiging</li>
</ol>
</nav>

<main style="max-width: 1280px; margin: 0 auto; padding: 32px; display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start">
<div style="flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 32px">
<h1 style="margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 32px">Stel je reis samen</h1>

<section style="display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-size: 20px">1. Kies je reisvorm</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px">
@foreach (var v in Vormen) {
<button type="button" @onclick="() => _gekozen = v" aria-pressed="@(v == _gekozen ? "true" : "false")" style="@Stijl(v)">
<span style="width: 44px; height: 44px; border-radius: 10px; border: 2px dashed var(--brand); display: flex; align-items: center; justify-content: center; font-size: 10px; color: var(--brand); font-weight: 700">ICOON</span>
<span style="font-size: 17px; font-weight: 700">@(v.Naam)</span>
<span style="font-size: 13px; color: var(--muted)">Reistijd: @(v.Tijd)</span>
<span style="font-size: 13px; color: var(--muted)">Comfort: @(v.Comfort)</span>
<span style="font-size: 15px; font-weight: 600; color: var(--brand)">@(v.Prijs)</span>
</button>
}
</div>
<p style="margin: 0; font-size: 13px; color: var(--muted)">Reisvormen komen uit de catalogus; een nieuwe vorm verschijnt hier zonder schermaanpassing.</p>
</section>

<section style="display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-size: 20px">2. Kies je verblijf</h2>
<div style="display: flex; flex-direction: column; gap: 10px">
<label style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center; border: 2px solid var(--brand); border-radius: 14px; padding: 14px"><input type="radio" name="verblijf" checked><span style="width: 96px; height: 64px; background: var(--surface); border-radius: 8px"></span><span style="flex: 1 1 200px"><strong>Basecamp Dome</strong><br><span style="font-size: 14px; color: var(--muted)">Standaard · gedeelde faciliteiten</span></span><span style="font-weight: 600">inbegrepen</span></label>
<label style="display: flex; flex-wrap: wrap; gap: 16px; align-items: center; border: 1px solid var(--border); border-radius: 14px; padding: 14px"><input type="radio" name="verblijf"><span style="width: 96px; height: 64px; background: var(--surface); border-radius: 8px"></span><span style="flex: 1 1 200px"><strong>Crater View Suite</strong><br><span style="font-size: 14px; color: var(--muted)">Privé · uitzicht op krater</span></span><span style="font-weight: 600">+ [PRIJS]</span></label>
</div>
</section>

<section style="display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-size: 20px">3. Activiteiten &amp; extra’s</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 10px; font-size: 15px">
<label style="display: flex; gap: 10px; justify-content: space-between; border: 1px solid var(--border); border-radius: 12px; padding: 14px"><span style="display: flex; gap: 10px"><input type="checkbox"> Rover-tocht Olympus Mons</span><span>+ [PRIJS]</span></label>
<label style="display: flex; gap: 10px; justify-content: space-between; border: 1px solid var(--border); border-radius: 12px; padding: 14px"><span style="display: flex; gap: 10px"><input type="checkbox"> Ruimtewandeling</span><span>+ [PRIJS]</span></label>
<label style="display: flex; gap: 10px; justify-content: space-between; border: 1px solid var(--border); border-radius: 12px; padding: 14px"><span style="display: flex; gap: 10px"><input type="checkbox"> Annuleringsverzekering</span><span>+ [PRIJS]</span></label>
<label style="display: flex; gap: 10px; justify-content: space-between; border: 1px solid var(--border); border-radius: 12px; padding: 14px"><span style="display: flex; gap: 10px"><input type="checkbox"> Ruimtereisverzekering</span><span>+ [PRIJS]</span></label>
</div>
</section>

<div style="display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px">
<a href="/reis" style="border: 1px solid var(--border); color: var(--ink); text-decoration: none; padding: 14px 22px; border-radius: 10px; font-weight: 600">Terug</a>
<a href="/boeken/gegevens" style="background: var(--brand); color: var(--white); text-decoration: none; padding: 14px 22px; border-radius: 10px; font-weight: 600">Verder naar gegevens</a>
</div>
</div>

<aside aria-label="Jouw reis" style="flex: 1 1 320px; border: 1px solid var(--border); border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 14px">
<h2 style="margin: 0; font-size: 18px">Jouw reis</h2>
<div style="height: 120px; background: var(--surface); border-radius: 10px"></div>
<p style="margin: 0; font-weight: 700">Mars Basecamp Expeditie</p>
<p style="margin: 0; font-size: 14px; color: var(--muted)">[DATUM] · 7 dagen · 2 reizigers</p>
<div style="display: flex; flex-direction: column; gap: 8px; font-size: 14px; border-top: 1px solid var(--line); padding-top: 12px">
<div style="display: flex; justify-content: space-between"><span>Basisreis × 2</span><span>[PRIJS]</span></div>
<div style="display: flex; justify-content: space-between"><span>Reisvorm: @(_gekozen.Naam)</span><span>@(_gekozen.Prijs)</span></div>
<div style="display: flex; justify-content: space-between"><span>Verblijf</span><span>inbegrepen</span></div>
<div style="display: flex; justify-content: space-between"><span>Extra’s</span><span>[PRIJS]</span></div>
</div>
<div style="border-top: 1px solid var(--line); padding-top: 12px; display: flex; justify-content: space-between; font-weight: 700; font-size: 18px"><span>Totaal</span><span>[TOTAAL]</span></div>
<p style="margin: 0; font-size: 12px; color: var(--muted)">Prijs gegarandeerd tot [TIJDSTIP]</p>
</aside>
</main>


@code {
    private record VormenItem(string Id, string Naam, string Tijd, string Comfort, string Prijs);

    private static readonly VormenItem[] Vormen =
    [
        new("raket", "Raket", "[X] dagen", "Basis", "inbegrepen"),
        new("tele", "Teleportatie", "direct", "Hoog", "+ [PRIJS]"),
        new("cruise", "Vliegend cruiseschip", "[X] dagen", "Luxe", "+ [PRIJS]"),
        new("vr", "VR Experience", "n.v.t.", "Thuis", "– [KORTING]"),
    ];

    private VormenItem _gekozen = Vormen[0];

    private const string KaartStijl = "background: var(--white); color: var(--ink); text-align: left; font-family: inherit; border-radius: 14px; padding: 16px; display: flex; flex-direction: column; gap: 6px; cursor: pointer; ";

    private string Stijl(VormenItem v) => KaartStijl + (v == _gekozen
        ? "border: 2px solid var(--brand); box-shadow: 0 0 0 3px var(--brand-tint)"
        : "border: 1px solid var(--border)");
}
