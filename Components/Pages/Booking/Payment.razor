@page "/boeken/betalen"

<PageTitle>VoyageVista – Overzicht en betalen</PageTitle>

<PayHeader />

<nav aria-label="Boekingsstappen" class="nav-1">
<ol class="ol-1">
<li class="li-1"><span class="span-1">✓</span>Reis kiezen</li>
<li class="li-1"><span class="span-1">✓</span>Samenstellen</li>
<li class="li-1"><span class="span-1">✓</span>Gegevens</li>
<li aria-current="step" class="li-2"><span class="span-2">4</span>Betalen</li>
<li class="li-3"><span class="span-3">5</span>Bevestiging</li>
</ol>
</nav>

<main class="main-1">
<div class="div-1">
<h1 class="h1-1">Controleer en betaal</h1>

<section class="section-1">
<div class="div-2"><h2 class="h2-1">Reis</h2><a href="/boeken/samenstellen" class="a-1">Wijzig</a></div>
<p class="p-1">Mars Basecamp Expeditie · [DATUM] – [DATUM]</p>
<p class="p-2">Raket · Basecamp Dome · Rover-tocht Olympus Mons</p>
</section>

<section class="section-1">
<div class="div-2"><h2 class="h2-1">Reizigers</h2><a href="/boeken/gegevens" class="a-1">Wijzig</a></div>
<p class="p-1">Sanne [ACHTERNAAM] (hoofdreiziger) · [REIZIGER 2]</p>
<p class="p-2">Bevestiging gaat naar [E-MAILADRES]</p>
</section>

<fieldset class="fieldset-1">
<legend class="legend-1">Betaalmethode</legend>
<label class="label-1"><input type="radio" name="betaal" @onchange="@(() => _methode = "ideal")" checked="@(_methode == "ideal")"> iDEAL</label>
<label class="label-2"><input type="radio" name="betaal" @onchange="@(() => _methode = "credit")" checked="@(_methode == "credit")"> Creditcard</label>
<label class="label-2"><input type="radio" name="betaal" @onchange="@(() => _methode = "aanbetaling")" checked="@(_methode == "aanbetaling")"> Aanbetaling nu ([X]%), rest uiterlijk [X] weken voor vertrek</label>
</fieldset>

<div class="div-3">
@if (_akkoordFout) {<div role="alert" class="div-4">Ga akkoord met de voorwaarden om verder te gaan.</div>}
<label class="label-3"><input type="checkbox" @bind="_akkoord" required> Ik ga akkoord met de <a href="/reis">reisvoorwaarden</a> en het <a href="/reis">annuleringsbeleid</a> *</label>
</div>

<div class="div-5">
<a href="/boeken/gegevens" class="a-2">Terug</a>
<button type="button" @onclick="Bevestig" class="button-1">Betalen en boeken</button>
</div>
</div>

<aside aria-label="Prijsoverzicht" class="aside-1">
<h2 class="h2-2">Prijsoverzicht</h2>
<div class="div-6"><span>Basisreis × 2</span><span>[PRIJS]</span></div>
<div class="div-6"><span>Reisvorm: Raket</span><span>inbegrepen</span></div>
<div class="div-6"><span>Rover-tocht × 2</span><span>[PRIJS]</span></div>
<div class="div-7"><span>Totaal</span><span>[TOTAAL]</span></div>
<p class="p-3">Incl. belastingen en toeslagen. Factuur volgt automatisch per e-mail.</p>
</aside>
</main>

@if (_toonModal) {
<div class="div-8">
<div role="dialog" aria-modal="true" aria-labelledby="bevestig-titel" class="div-9">
<h2 id="bevestig-titel" class="h2-3">Boeking bevestigen?</h2>
<p class="p-4">Je boekt <strong>Mars Basecamp Expeditie</strong> voor 2 reizigers voor <strong>[TOTAAL]</strong>. Na betaling gelden de annuleringsvoorwaarden.</p>
<div class="div-10">
<button type="button" @onclick="() => _toonModal = false" class="button-2">Annuleren</button>
<a href="/boeken/bevestiging" class="a-3">Ja, betaal en boek</a>
</div>
</div>
</div>
}


@code {
    private bool _toonModal, _akkoord, _akkoordFout;
    private string _methode = "ideal";

    private void Bevestig()
    {
        _akkoordFout = !_akkoord;
        _toonModal = _akkoord;
    }
}
