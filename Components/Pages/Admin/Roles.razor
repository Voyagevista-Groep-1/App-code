@page "/admin/roles"
@layout AdminLayout
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Roles = "Admin")]
@using Microsoft.EntityFrameworkCore
@using tui.Data
@inject IDbContextFactory<ApplicationDbContext> DbFactory

<PageTitle>Rollen</PageTitle>

<div class="roles-page">
    <div class="roles-grid">
        <section class="roles-card roles-overview">
            <div class="card-heading">
                <div>
                    <h1>Rollen</h1>
                    <p>Geconfigureerde rollen en gekoppelde gebruikers</p>
                </div>
                <span class="role-count">@roles.Count rollen</span>
            </div>

            <div class="create-role">
                <input aria-label="Nieuwe rolnaam" placeholder="Nieuwe rolnaam..." @bind="newRoleName" />
                <button class="button button-primary" @onclick="CreateRole">Toevoegen</button>
            </div>
            @if (!string.IsNullOrWhiteSpace(createMessage))
            {
                <p class="feedback">@createMessage</p>
            }

            <div class="role-list">
                @foreach (var r in roles)
                {
                    <div class="role-row">
                        <div>
                            <strong>@r.Name</strong>
                            <small>ID: @r.Id</small>
                        </div>
                        <button class="button button-danger" @onclick="() => DeleteRole(r.Id)">Verwijderen</button>
                    </div>
                }
            </div>
        </section>

        <section class="roles-card assignment-card">
            <div class="card-heading">
                <div>
                    <h2>Rol toewijzen</h2>
                    <p>Koppel rollen aan een gebruiker</p>
                </div>
                @if (selectedUser != null)
                {
                    <span class="selected-badge">Geselecteerd</span>
                }
            </div>

            <div class="user-search">
                <input aria-label="Zoek gebruiker" placeholder="Zoek op e-mailadres of naam..." type="text" @bind="searchTerm" @bind:event="oninput" />
            </div>

            @if (!string.IsNullOrWhiteSpace(searchTerm))
            {
                <div class="user-results">
                    <h3>Gebruikers</h3>
                    <div class="table-wrap">
                        <table>
                            <thead>
                            <tr>
                                <th>E-mailadres</th><th>Naam</th><th>Rollen</th><th></th>
                            </tr>
                            </thead>
                            <tbody>
                            @foreach (var u in users.Where(x => x.Email.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) || (x.FirstName + " " + x.LastName).Contains(searchTerm, StringComparison.OrdinalIgnoreCase)))
                            {
                                <tr>
                                    <td>@u.Email</td>
                                    <td>@u.FirstName @u.LastName</td>
                                    <td>@string.Join(", ", u.UserRoles.Select(ur => ur.Role.Name))</td>
                                    <td><button class="button button-light" @onclick="() => SelectUser(u)">Selecteren</button></td>
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                </div>
            }

            @if (selectedUser != null)
            {
                <div class="selected-user">
                    <div class="selected-user-heading">
                        <div>
                            <h3>Rollen voor @selectedUser.Email</h3>
                            <p>Selecteer de rollen die deze gebruiker mag gebruiken.</p>
                        </div>
                    </div>
                    <div class="role-options">
                        @foreach (var r in roles)
                        {
                            <label class="role-option">
                                <input type="checkbox" checked="@selectedRoleIds.Contains(r.Id)" @onchange="e => ToggleRole(r.Id, (bool)(e.Value ?? false))" />
                                <span>@r.Name</span>
                            </label>
                        }
                    </div>
                    <div class="save-actions">
                        <button class="button button-primary" @onclick="Save">Opslaan</button>
                        <p class="feedback">@saveMessage</p>
                    </div>
                </div>
            }
        </section>
    </div>
</div>

@code {
    private string newRoleName = string.Empty;
    private string createMessage = string.Empty;
    private string saveMessage = string.Empty;
    private string searchTerm = string.Empty;

    private List<Role> roles = new();
    private List<AppUser> users = new();
    private AppUser? selectedUser;
    private HashSet<int> selectedRoleIds = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        roles = await db.Roles.OrderBy(r => r.Name).ToListAsync();
        users = await db.AppUsers
            .Include(u => u.UserRoles)
            .ThenInclude(ur => ur.Role)
            .OrderBy(u => u.Email)
            .ToListAsync();
    }

    private async Task CreateRole()
    {
        if (string.IsNullOrWhiteSpace(newRoleName))
        {
            createMessage = "Voer een rolnaam in";
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        var name = newRoleName.Trim();
        if (await db.Roles.AnyAsync(r => r.Name == name))
        {
            createMessage = "Rol bestaat al";
            return;
        }

        db.Roles.Add(new Role { Name = name });
        await db.SaveChangesAsync();
        newRoleName = string.Empty;
        createMessage = "Aangemaakt";
        await LoadData();
    }

    private async Task DeleteRole(int roleId)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        var role = await db.Roles.FindAsync(roleId);
        if (role == null) return;
        var hasUsers = await db.UserRoles.AnyAsync(ur => ur.RoleId == roleId);
        if (hasUsers)
        {
            createMessage = "Rol kan niet worden verwijderd omdat deze nog is toegewezen.";
            return;
        }
        db.Roles.Remove(role);
        await db.SaveChangesAsync();
        createMessage = "Rol verwijderd";
        await LoadData();
        if (selectedUser != null)
        {
            selectedUser = users.FirstOrDefault(x => x.UserId == selectedUser.UserId);
            if (selectedUser != null) selectedRoleIds = new HashSet<int>(selectedUser.UserRoles.Select(ur => ur.RoleId));
        }
    }

    private void SelectUser(AppUser u)
    {
        selectedUser = u;
        selectedRoleIds = new HashSet<int>(u.UserRoles.Select(ur => ur.RoleId));
        saveMessage = string.Empty;
    }

    private void ToggleRole(int roleId, bool add)
    {
        if (add) selectedRoleIds.Add(roleId);
        else selectedRoleIds.Remove(roleId);
    }

    private async Task Save()
    {
        if (selectedUser == null) return;
        saveMessage = string.Empty;
        try
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            var user = await db.AppUsers.Include(u => u.UserRoles).FirstOrDefaultAsync(u => u.UserId == selectedUser.UserId);
            if (user == null)
            {
                saveMessage = "Gebruiker bestaat niet meer.";
                await LoadData();
                selectedUser = null;
                return;
            }

            foreach (var rid in selectedRoleIds)
            {
                if (!await db.Roles.AnyAsync(r => r.Id == rid))
                {
                    saveMessage = "Ongeldige rollen kunnen niet worden toegewezen.";
                    return;
                }
            }

            db.UserRoles.RemoveRange(user.UserRoles);
            foreach (var rid in selectedRoleIds.Distinct())
            {
                db.UserRoles.Add(new UserRole { UserId = user.UserId, RoleId = rid });
            }

            await db.SaveChangesAsync();
            saveMessage = "Rollen succesvol gewijzigd.";
            await LoadData();
            selectedUser = users.FirstOrDefault(x => x.UserId == selectedUser.UserId);
            if (selectedUser != null) selectedRoleIds = new HashSet<int>(selectedUser.UserRoles.Select(ur => ur.RoleId));
        }
        catch
        {
            saveMessage = "Er is een fout opgetreden tijdens het opslaan. De eerder opgeslagen rollen zijn behouden.";
            await LoadData();
            if (selectedUser != null)
            {
                selectedUser = users.FirstOrDefault(x => x.UserId == selectedUser.UserId);
                if (selectedUser != null) selectedRoleIds = new HashSet<int>(selectedUser.UserRoles.Select(ur => ur.RoleId));
            }
        }
    }

}
