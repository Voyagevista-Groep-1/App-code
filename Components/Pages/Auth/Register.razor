@page "/auth/register"
@layout AuthLayout
@using System.Text.RegularExpressions
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>Registreren</PageTitle>

<div class="main">
    <div class="login-container">
        <div class="login-header">
            <h3>Registreren</h3>
        </div>

        @if (!string.IsNullOrWhiteSpace(_message))
        {
            <p class="@(_registrationSucceeded ? "success-message" : "error-message")">@_message</p>
        }

        <form @onsubmit="OnRegister">
            <AntiforgeryToken />
            <input type="text" placeholder="Voornaam" @bind="_firstName" required />
            <input type="text" placeholder="Achternaam" @bind="_lastName" required />
            <input type="email" placeholder="E-mailadres" @bind="_email" required />
            <div class="password-input">
                <input type="@(_showPassword ? "text" : "password")" placeholder="Wachtwoord (minimaal 16 tekens)" @bind="_password" pattern="(?=.*[A-Z])(?=.*[^A-Za-z0-9\s])\S{16,}" title="Gebruik minimaal 16 tekens, minstens één hoofdletter en één speciaal teken, zonder spaties." required />
                <button type="button" class="password-toggle" @onclick="() => _showPassword = !_showPassword" aria-label="@(_showPassword ? "Wachtwoord verbergen" : "Wachtwoord tonen")" title="@(_showPassword ? "Wachtwoord verbergen" : "Wachtwoord tonen")">@( _showPassword ? "◉" : "◌" )</button>
            </div>
            <div class="password-input">
                <input type="@(_showConfirmPassword ? "text" : "password")" placeholder="Wachtwoord bevestigen" @bind="_confirmPassword" pattern="(?=.*[A-Z])(?=.*[^A-Za-z0-9\s])\S{16,}" title="Gebruik minimaal 16 tekens, minstens één hoofdletter en één speciaal teken, zonder spaties." required />
                <button type="button" class="password-toggle" @onclick="() => _showConfirmPassword = !_showConfirmPassword" aria-label="@(_showConfirmPassword ? "Wachtwoord verbergen" : "Wachtwoord tonen")" title="@(_showConfirmPassword ? "Wachtwoord verbergen" : "Wachtwoord tonen")">@( _showConfirmPassword ? "◉" : "◌" )</button>
            </div>
            <button type="submit">Registreren</button>
        </form>

        <div class="register-link">
            <p>Heb je al een account? <a href="/auth/login">Inloggen</a></p>
        </div>
    </div>
</div>

@code {
    private string _firstName = string.Empty;
    private string _lastName = string.Empty;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _message;
    private bool _registrationSucceeded;
    private bool _showPassword;
    private bool _showConfirmPassword;
    private static readonly Regex PasswordRegex = new(@"^(?=.*[A-Z])(?=.*[^A-Za-z0-9\s])\S{16,}$", RegexOptions.CultureInvariant);

    private async Task OnRegister()
    {
        if (!PasswordRegex.IsMatch(_password))
        {
            _registrationSucceeded = false;
            _message = "Het wachtwoord moet minimaal 16 tekens bevatten, minstens één hoofdletter en één speciaal teken, zonder spaties.";
            return;
        }


        if (_password != _confirmPassword)
        {
            _registrationSucceeded = false;
            _message = "De wachtwoorden komen niet overeen.";
            return;
        }

        var result = await AuthService.RegisterAsync(_firstName, _lastName, _email, _password);

        if (result.Success)
        {
            Navigation.NavigateTo("/auth/login?registered=true");
            return;
        }

        _registrationSucceeded = false;
        _message = $"Registratie mislukt: {result.Error}";
    }
}
