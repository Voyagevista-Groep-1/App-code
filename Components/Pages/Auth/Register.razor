@page "/auth/register"
@layout AuthLayout
@inject AuthService AuthService
@inject NavigationManager Navigation

<PageTitle>VoyageVista – Registreren</PageTitle>

<div class="auth-card">
    <h1>Registreren</h1>
    <p class="auth-lead">Maak een account om je boekingen te beheren.</p>

    @if (_message is not null)
    {
        <p class="auth-alert auth-alert--error" role="alert">@_message</p>
    }

    <form class="auth-form" @onsubmit="OnRegister">
        <label>Voornaam *
            <input type="text" @bind="_firstName" autocomplete="given-name" maxlength="50" required />
        </label>
        <label>Achternaam *
            <input type="text" @bind="_lastName" autocomplete="family-name" maxlength="50" required />
        </label>
        <label>E-mailadres *
            <input type="email" @bind="_email" autocomplete="email" maxlength="200" required />
        </label>
        <label>Wachtwoord *
            <span class="auth-password">
                <input type="@(_showPassword ? "text" : "password")" @bind="_password" autocomplete="new-password" minlength="8" pattern="(?=.*[A-Za-z])(?=.*[0-9]).{8,}" title="@AuthService.PasswordRule" required />
                <button type="button" class="auth-toggle" @onclick="() => _showPassword = !_showPassword">@(_showPassword ? "Verberg" : "Toon")</button>
            </span>
            <small>Minimaal 8 tekens, met een letter en een cijfer.</small>
        </label>
        <label>Wachtwoord bevestigen *
            <input type="@(_showPassword ? "text" : "password")" @bind="_confirmPassword" autocomplete="new-password" required />
        </label>
        <button type="submit" class="btn btn--primary">Registreren</button>
    </form>

    <p class="auth-switch">Heb je al een account? <a href="/auth/login">Inloggen</a></p>
</div>

@code {
    private string _firstName = "", _lastName = "", _email = "", _password = "", _confirmPassword = "";
    private string? _message;
    private bool _showPassword;

    private async Task OnRegister()
    {
        if (_password != _confirmPassword)
        {
            _message = "De wachtwoorden komen niet overeen.";
            return;
        }

        var result = await AuthService.RegisterAsync(_firstName, _lastName, _email, _password);

        if (result.Success)
        {
            Navigation.NavigateTo("/auth/login?registered=true");
            return;
        }

        _message = result.Error;
    }
}
