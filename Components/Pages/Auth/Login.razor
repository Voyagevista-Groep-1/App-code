@page "/auth/login"
@layout AuthLayout
@inject AuthenticationStateProvider AuthStateProvider

<PageTitle>VoyageVista – Inloggen</PageTitle>

<div class="auth-card">
    <h1>Inloggen</h1>
    <p class="auth-lead">Welkom terug! Log in op je account.</p>

    @if (!string.IsNullOrWhiteSpace(Error))
    {
        <p class="auth-alert auth-alert--error" role="alert">@Error</p>
    }

    @if (Registered == "true")
    {
        <p class="auth-alert auth-alert--success">Registratie geslaagd! Je kunt nu inloggen.</p>
    }

    @if (_firstName is not null)
    {
        <p class="auth-alert auth-alert--success">Je bent ingelogd als <strong>@_firstName</strong>.</p>
        <div class="auth-actions">
            <a class="btn btn--primary" href="@(ReturnUrl ?? "/")">Verder</a>
            <form method="post" action="/auth/logout">
                <AntiforgeryToken />
                <button type="submit" class="btn btn--ghost">Uitloggen</button>
            </form>
        </div>
    }
    else
    {
        <form method="post" action="/auth/login" class="auth-form">
            <AntiforgeryToken />
            <input type="hidden" name="returnUrl" value="@ReturnUrl" />
            <label>E-mailadres *
                <input type="email" name="email" autocomplete="email" maxlength="200" required />
            </label>
            <label>Wachtwoord *
                <span class="auth-password">
                    <input type="@(_showPassword ? "text" : "password")" name="password" autocomplete="current-password" required />
                    <button type="button" class="auth-toggle" @onclick="() => _showPassword = !_showPassword">@(_showPassword ? "Verberg" : "Toon")</button>
                </span>
            </label>
            <button type="submit" class="btn btn--primary">Inloggen</button>
        </form>

        <p class="auth-switch">Nog geen account? <a href="/auth/register">Registreren</a></p>
    }
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")] private string? Error { get; set; }
    [SupplyParameterFromQuery(Name = "registered")] private string? Registered { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] private string? ReturnUrl { get; set; }

    private string? _firstName;
    private bool _showPassword;

    protected override async Task OnInitializedAsync()
    {
        var user = (await AuthStateProvider.GetAuthenticationStateAsync()).User;
        if (user.Identity?.IsAuthenticated == true)
        {
            _firstName = user.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value;
        }

        if (ReturnUrl is not null && (ReturnUrl.Length == 0 || ReturnUrl[0] != '/' || ReturnUrl.StartsWith("//") || ReturnUrl.StartsWith("/\\")))
        {
            ReturnUrl = null;
        }
    }
}
