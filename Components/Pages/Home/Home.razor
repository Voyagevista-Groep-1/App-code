@page "/"

<PageTitle>VoyageVista – Home</PageTitle>

<SiteHeader />

<section class="section-1">
<div class="div-1">
<div class="div-2">
<div class="div-3">
<p class="p-1">Interplanetair reisplatform</p>
<h1 class="h1-1">Boek je reis naar een andere planeet</h1>
<p class="p-2">[KORTE PAYOFF: wat maakt VoyageVista uniek voor reizigers van 18–30 jaar]</p>
</div>
<div class="div-4">Afbeelding: hero-visual (planeet / ruimteschip)</div>
</div>

<form aria-label="Reis zoeken" method="get" action="/bestemmingen" class="form-1">
<label class="label-1">Bestemming
<select name="planeet" class="select-1">
<option value="">Alle planeten</option><option>Mars</option><option>Saturnus</option><option>Pluto</option><option>Venus</option>
</select></label>
<label class="label-1">Vertrekdatum
<input type="date" name="datum" required min="@DateTime.Today.ToString("yyyy-MM-dd")" class="input-1"></label>
<label class="label-1">Reizigers
<input type="number" name="reizigers" value="2" min="1" max="10" step="1" required class="input-1"></label>
<label class="label-1">Reisvorm
<select name="vorm" class="select-1">
<option value="">Alle reisvormen</option><option>Raket</option><option>Teleportatie</option><option>Vliegend cruiseschip</option><option>Virtual Reality Experience</option>
</select></label>
<button type="submit" class="button-1">Zoek reizen</button>
</form>
</div>
</section>

<section class="section-2">
<div class="div-5">
<div>
<h2 class="h2-1">Populaire bestemmingen</h2>
<p class="p-3">Lijst komt uit de productcatalogus – nieuwe planeten verschijnen automatisch.</p>
</div>
<a href="/bestemmingen" class="a-1">Alle bestemmingen</a>
</div>
<div class="div-6">
@foreach (var p in Planeten) {
<a href="/reis" class="a-2">
<div class="div-7">Afbeelding: @(p.Naam)</div>
<div class="div-8">
<span class="span-1">@(p.Naam)</span>
<span class="span-2">@(p.Kenmerk)</span>
<span class="span-3">vanaf [PRIJS] p.p.</span>
</div>
</a>
}
</div>
</section>

<section class="section-3">
<h2 class="h2-1">Kies je reisvorm</h2>
<div class="div-6">
@foreach (var r in Reisvormen) {
<a href="/bestemmingen" class="a-3">
<span class="span-4">ICOON</span>
<span class="span-5">@(r.Naam)</span>
<span class="span-6">@(r.Uitleg)</span>
</a>
}
</div>
</section>

<section class="section-4">
<div class="div-9">
<div class="div-10">
<p class="p-4">Speciaal voor jou</p>
<h2 class="h2-2">[CAMPAGNETITEL – gepersonaliseerd op voorkeuren klant]</h2>
<p class="p-5">[Campagnetekst. Ingelogde klant: aanbod o.b.v. eerdere boekingen en voorkeuren. Gast: algemene actie.]</p>
<div><a href="/bestemmingen" class="a-4">Bekijk aanbieding</a></div>
</div>
<div class="div-11">Afbeelding: campagnebeeld</div>
</div>
</section>

<section class="section-3">
<h2 class="h2-1">Waarom VoyageVista</h2>
<div class="div-6">
<div class="div-12"><p class="p-6">Actuele prijzen</p><p class="p-7">Prijs en beschikbaarheid altijd live uit één systeem.</p></div>
<div class="div-12"><p class="p-6">Zelf samenstellen</p><p class="p-7">Kies reisvorm, verblijf en activiteiten in een paar stappen.</p></div>
<div class="div-12"><p class="p-6">Alles op één plek</p><p class="p-7">Boekingen, facturen en vragen in je eigen account.</p></div>
<div class="div-12"><p class="p-6">[USP 4]</p><p class="p-7">[Uitkomst concurrentieanalyse]</p></div>
</div>
</section>

<footer class="footer-1">
<div class="div-13">
<span class="span-7">VoyageVista</span>
<div class="div-14"><strong class="strong-1">Service</strong><span>Klantenservice</span><span>Veelgestelde vragen</span><span>Klacht indienen</span></div>
<div class="div-14"><strong class="strong-1">Over ons</strong><span>Over VoyageVista</span><span>Voorwaarden</span><span>Privacy</span></div>
<div class="div-14"><strong class="strong-1">Volg ons</strong><span>[Social media links]</span></div>
</div>
</footer>


@code {
    private record PlanetenItem(string Naam, string Kenmerk);

    private static readonly PlanetenItem[] Planeten =
    [
        new("Mars", "Rode woestijnen & basecamps"),
        new("Saturnus", "Ringenrondvlucht"),
        new("Pluto", "IJsvlaktes aan de rand"),
        new("Venus", "Wolkenstad-ervaring"),
    ];

    private record ReisvormenItem(string Naam, string Uitleg);

    private static readonly ReisvormenItem[] Reisvormen =
    [
        new("Raket", "Snel en avontuurlijk, met lancering."),
        new("Teleportatie", "Direct ter plaatse, zonder reistijd."),
        new("Vliegend cruiseschip", "Comfortabel, de reis is de ervaring."),
        new("Virtual Reality Experience", "Beleef de planeet vanaf de aarde."),
    ];

}
