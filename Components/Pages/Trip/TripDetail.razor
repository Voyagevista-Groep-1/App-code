@page "/reis"

<PageTitle>VoyageVista – Reisdetail</PageTitle>

@@<SiteHeader Active="true" />@@

<main style="max-width: 1280px; margin: 0 auto; padding: 24px 32px 64px; display: flex; flex-direction: column; gap: 24px">
<nav aria-label="Kruimelpad" style="font-size: 14px; color: #55607A; display: flex; gap: 8px; flex-wrap: wrap">
<a href="/">Home</a><span>/</span><a href="/bestemmingen">Bestemmingen</a><span>/</span><span>Mars</span><span>/</span><span style="color: #16163F">Mars Basecamp Expeditie</span>
</nav>

<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 12px">
<div style="grid-column: span 2; min-height: 340px; background: #EEF3FB; border-radius: 16px; display: flex; align-items: center; justify-content: center; color: #55607A">Afbeelding: hoofdfoto bestemming</div>
<div style="display: grid; grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 12px">
<div style="background: #EEF3FB; border-radius: 16px; display: flex; align-items: center; justify-content: center; color: #55607A; font-size: 14px">Afbeelding: accommodatie</div>
<div style="background: #EEF3FB; border-radius: 16px; display: flex; align-items: center; justify-content: center; color: #55607A; font-size: 14px">Afbeelding: activiteit</div>
</div>
</div>

<div style="display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start">
<div style="flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 24px">
<div style="display: flex; flex-direction: column; gap: 10px">
<div style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 12px; font-weight: 600">
<span style="background: #E7DFFB; color: #3F2A9E; padding: 4px 10px; border-radius: 999px">Mars</span>
<span style="background: #F1F3F8; color: #3A3F5C; padding: 4px 10px; border-radius: 999px">7 dagen</span>
<span style="background: #F1F3F8; color: #3A3F5C; padding: 4px 10px; border-radius: 999px">Avontuur</span>
</div>
<h1 style="margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 40px">Mars Basecamp Expeditie</h1>
<p style="margin: 0; color: #55607A">[Beoordeling: X,X / 5 uit [AANTAL] reviews]</p>
</div>

<div role="tablist" aria-label="Reisinformatie" style="display: flex; flex-wrap: wrap; gap: 4px; border-bottom: 1px solid #E3E7F0">
<button type="button" role="tab" aria-selected="true" style="background: none; border: 0; border-bottom: 3px solid #5A3FD1; padding: 12px 16px; font-weight: 700; font-size: 15px; color: #16163F; font-family: inherit">Overzicht</button>
<button type="button" role="tab" aria-selected="false" style="background: none; border: 0; padding: 12px 16px; font-size: 15px; color: #55607A; font-family: inherit">Programma</button>
<button type="button" role="tab" aria-selected="false" style="background: none; border: 0; padding: 12px 16px; font-size: 15px; color: #55607A; font-family: inherit">Accommodatie</button>
<button type="button" role="tab" aria-selected="false" style="background: none; border: 0; padding: 12px 16px; font-size: 15px; color: #55607A; font-family: inherit">Activiteiten</button>
<button type="button" role="tab" aria-selected="false" style="background: none; border: 0; padding: 12px 16px; font-size: 15px; color: #55607A; font-family: inherit">Voorwaarden &amp; gezondheid</button>
</div>

<p style="margin: 0; line-height: 1.6; color: #3A3F5C">[Productomschrijving: vastgelegd door Productontwikkeling in één standaardformaat, zodat klant, sales en klantenservice dezelfde informatie zien.]</p>

<div>
<h2 style="margin: 0 0 12px; font-size: 20px">Inbegrepen</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 12px; font-size: 15px">
<div style="background: #EEF3FB; border-radius: 12px; padding: 14px">Heen- en terugreis</div>
<div style="background: #EEF3FB; border-radius: 12px; padding: 14px">[X] nachten accommodatie</div>
<div style="background: #EEF3FB; border-radius: 12px; padding: 14px">Ruimtepak &amp; uitrusting</div>
<div style="background: #EEF3FB; border-radius: 12px; padding: 14px">Gids ter plaatse</div>
</div>
</div>

<div>
<h2 style="margin: 0 0 12px; font-size: 20px">Dagprogramma</h2>
<ol style="margin: 0; padding: 0; list-style: none; display: flex; flex-direction: column; gap: 10px">
@foreach (var d in Dagen) {
<li style="display: flex; gap: 16px; border: 1px solid #E3E7F0; border-radius: 12px; padding: 14px">
<span style="font-weight: 700; color: #5A3FD1; min-width: 64px">@(d.Dag)</span>
<span>@(d.Tekst)</span>
</li>
}
</ol>
</div>

<div style="border: 1px solid #E3E7F0; border-radius: 16px; padding: 20px; display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px">
<div><p style="margin: 0; font-weight: 700">Vraag over deze reis?</p><p style="margin: 4px 0 0; font-size: 14px; color: #55607A">Je vraag komt direct bij klantenservice, gekoppeld aan deze reis.</p></div>
<a href="/mijn-reizen" style="border: 1px solid #5A3FD1; color: #5A3FD1; text-decoration: none; padding: 12px 18px; border-radius: 10px; font-weight: 600">Stel een vraag</a>
</div>
</div>

<aside aria-label="Boeken" style="flex: 1 1 340px; border: 1px solid #C9D1E3; border-radius: 16px; padding: 24px; display: flex; flex-direction: column; gap: 16px; box-shadow: 0 8px 24px rgba(22,22,63,0.08)">
<div><span style="font-size: 13px; color: #55607A">vanaf</span><p style="margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 32px; font-weight: 700">[PRIJS] <span style="font-size: 15px; font-weight: 500; color: #55607A">p.p.</span></p></div>
<label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600">Vertrekdatum
<select style="height: 48px; border: 1px solid #C9D1E3; border-radius: 10px; padding: 0 12px; font-family: inherit; font-size: 15px; background: #FFFFFF; color: #16163F"><option>[DATUM 1] – beschikbaar</option><option>[DATUM 2] – nog [X] plekken</option><option>[DATUM 3] – vol (wachtlijst)</option></select></label>
<label style="display: flex; flex-direction: column; gap: 6px; font-size: 13px; font-weight: 600">Aantal reizigers
<input type="number" value="2" style="height: 48px; border: 1px solid #C9D1E3; border-radius: 10px; padding: 0 12px; font-family: inherit; font-size: 15px"></label>
<fieldset style="border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 8px">
<legend style="font-size: 13px; font-weight: 600; margin-bottom: 8px">Beschikbare reisvormen</legend>
<label style="display: flex; justify-content: space-between; gap: 8px; border: 2px solid #5A3FD1; border-radius: 10px; padding: 12px; font-size: 15px"><span style="display: flex; gap: 8px"><input type="radio" name="vorm" checked> Raket</span><span style="color: #55607A">inbegrepen</span></label>
<label style="display: flex; justify-content: space-between; gap: 8px; border: 1px solid #C9D1E3; border-radius: 10px; padding: 12px; font-size: 15px"><span style="display: flex; gap: 8px"><input type="radio" name="vorm"> Teleportatie</span><span style="color: #55607A">+ [PRIJS]</span></label>
<label style="display: flex; justify-content: space-between; gap: 8px; border: 1px solid #C9D1E3; border-radius: 10px; padding: 12px; font-size: 15px"><span style="display: flex; gap: 8px"><input type="radio" name="vorm"> Vliegend cruiseschip</span><span style="color: #55607A">+ [PRIJS]</span></label>
</fieldset>
<div style="border-top: 1px solid #E3E7F0; padding-top: 14px; display: flex; justify-content: space-between; font-weight: 700"><span>Totaal (2 pers.)</span><span>[TOTAAL]</span></div>
<p style="margin: 0; font-size: 12px; color: #55607A">Prijs en beschikbaarheid actueel per [TIJDSTIP].</p>
<a href="/boeken/samenstellen" style="background: #5A3FD1; color: #FFFFFF; text-decoration: none; text-align: center; padding: 14px; border-radius: 10px; font-weight: 600; font-size: 16px">Reis samenstellen</a>
<button type="button" style="background: #FFFFFF; border: 1px solid #C9D1E3; color: #16163F; padding: 12px; border-radius: 10px; font-weight: 600; font-family: inherit; font-size: 15px">Bewaar op verlanglijst</button>
</aside>
</div>

<section style="display: flex; flex-direction: column; gap: 16px; padding-top: 16px">
<h2 style="margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 26px">Vergelijkbare reizen</h2>
<div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px">
<a href="/reis" style="text-decoration: none; color: #16163F; border: 1px solid #E3E7F0; border-radius: 16px; padding: 16px"><div style="height: 120px; background: #EEF3FB; border-radius: 10px; margin-bottom: 12px"></div><strong>[Reis A]</strong><p style="margin: 4px 0 0; font-size: 14px; color: #55607A">vanaf [PRIJS]</p></a>
<a href="/reis" style="text-decoration: none; color: #16163F; border: 1px solid #E3E7F0; border-radius: 16px; padding: 16px"><div style="height: 120px; background: #EEF3FB; border-radius: 10px; margin-bottom: 12px"></div><strong>[Reis B]</strong><p style="margin: 4px 0 0; font-size: 14px; color: #55607A">vanaf [PRIJS]</p></a>
<a href="/reis" style="text-decoration: none; color: #16163F; border: 1px solid #E3E7F0; border-radius: 16px; padding: 16px"><div style="height: 120px; background: #EEF3FB; border-radius: 10px; margin-bottom: 12px"></div><strong>[Reis C]</strong><p style="margin: 4px 0 0; font-size: 14px; color: #55607A">vanaf [PRIJS]</p></a>
</div>
</section>
</main>


@code {
    private record DagenItem(string Dag, string Tekst);

    private static readonly DagenItem[] Dagen =
    [
        new("Dag 1", "Vertrek vanaf [LANCEERBASIS], aankomst Basecamp"),
        new("Dag 2–3", "[Activiteit: rover-tocht Olympus Mons]"),
        new("Dag 4–6", "[Vrije dagen / optionele activiteiten]"),
        new("Dag 7", "Terugreis naar de aarde"),
    ];

}
