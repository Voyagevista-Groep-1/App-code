@page "/reis"

<PageTitle>VoyageVista – Reisdetail</PageTitle>

<SiteHeader Active="true" />

<main class="main-1">
<nav aria-label="Kruimelpad" class="nav-1">
<a href="/">Home</a><span>/</span><a href="/bestemmingen">Bestemmingen</a><span>/</span><span>Mars</span><span>/</span><span class="span-1">Mars Basecamp Expeditie</span>
</nav>

<div class="div-1">
<div class="div-2">Afbeelding: hoofdfoto bestemming</div>
<div class="div-3">
<div class="div-4">Afbeelding: accommodatie</div>
<div class="div-4">Afbeelding: activiteit</div>
</div>
</div>

<div class="div-5">
<div class="div-6">
<div class="div-7">
<div class="div-8">
<span class="span-2">Mars</span>
<span class="span-3">7 dagen</span>
<span class="span-3">Avontuur</span>
</div>
<h1 class="h1-1">Mars Basecamp Expeditie</h1>
<p class="p-1">[Beoordeling: X,X / 5 uit [AANTAL] reviews]</p>
</div>


<p class="p-2">[Productomschrijving: vastgelegd door Productontwikkeling in één standaardformaat, zodat klant, sales en klantenservice dezelfde informatie zien.]</p>

<div>
<h2 class="h2-1">Inbegrepen</h2>
<div class="div-9">
<div class="div-10">Heen- en terugreis</div>
<div class="div-10">[X] nachten accommodatie</div>
<div class="div-10">Ruimtepak &amp; uitrusting</div>
<div class="div-10">Gids ter plaatse</div>
</div>
</div>

<div>
<h2 class="h2-1">Dagprogramma</h2>
<ol class="ol-1">
@foreach (var d in Dagen) {
<li class="li-1">
<span class="span-4">@(d.Dag)</span>
<span>@(d.Tekst)</span>
</li>
}
</ol>
</div>

<div class="div-11">
<div><p class="p-3">Vraag over deze reis?</p><p class="p-4">Je vraag komt direct bij klantenservice, gekoppeld aan deze reis.</p></div>
<a href="/mijn-reizen" class="a-1">Stel een vraag</a>
</div>
</div>

<form method="get" action="/boeken/samenstellen" aria-label="Boeken" class="form-1">
<div><span class="span-5">vanaf</span><p class="p-5">[PRIJS] <span class="span-6">p.p.</span></p></div>
<label class="label-1">Vertrekdatum
<select name="datum" required class="select-1"><option value="1">[DATUM 1] – beschikbaar</option><option value="2">[DATUM 2] – nog [X] plekken</option><option value="3" disabled>[DATUM 3] – vol (wachtlijst)</option></select></label>
<label class="label-1">Aantal reizigers
<input type="number" name="reizigers" value="2" min="1" max="10" step="1" required class="input-1"></label>
<fieldset class="fieldset-1">
<legend class="legend-1">Beschikbare reisvormen</legend>
<label class="label-2"><span class="span-7"><input type="radio" name="vorm" value="Raket" checked> Raket</span><span class="span-8">inbegrepen</span></label>
<label class="label-3"><span class="span-7"><input type="radio" name="vorm" value="Teleportatie" required> Teleportatie</span><span class="span-8">+ [PRIJS]</span></label>
<label class="label-3"><span class="span-7"><input type="radio" name="vorm" value="Vliegend cruiseschip" required> Vliegend cruiseschip</span><span class="span-8">+ [PRIJS]</span></label>
</fieldset>
<div class="div-12"><span>Totaal (2 pers.)</span><span>[TOTAAL]</span></div>
<p class="p-6">Prijs en beschikbaarheid actueel per [TIJDSTIP].</p>
<button type="submit" class="button-1">Reis samenstellen</button>
</form>
</div>

<section class="section-1">
<h2 class="h2-2">Vergelijkbare reizen</h2>
<div class="div-13">
<a href="/reis" class="a-2"><div class="div-14"></div><strong>[Reis A]</strong><p class="p-4">vanaf [PRIJS]</p></a>
<a href="/reis" class="a-2"><div class="div-14"></div><strong>[Reis B]</strong><p class="p-4">vanaf [PRIJS]</p></a>
<a href="/reis" class="a-2"><div class="div-14"></div><strong>[Reis C]</strong><p class="p-4">vanaf [PRIJS]</p></a>
</div>
</section>
</main>


@code {
    private record DagenItem(string Dag, string Tekst);

    private static readonly DagenItem[] Dagen =
    [
        new("Dag 1", "Vertrek vanaf [LANCEERBASIS], aankomst Basecamp"),
        new("Dag 2–3", "[Activiteit: rover-tocht Olympus Mons]"),
        new("Dag 4–6", "[Vrije dagen / optionele activiteiten]"),
        new("Dag 7", "Terugreis naar de aarde"),
    ];

}
