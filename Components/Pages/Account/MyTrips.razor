@page "/mijn-reizen"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]

<PageTitle>VoyageVista – Mijn reizen</PageTitle>

<SiteHeader />

<main class="main-1">
<nav aria-label="Accountmenu" class="nav-1">
<a href="/mijn-reizen" aria-current="page" class="a-1">Mijn reizen</a>
</nav>

<div class="div-1">
<h1 class="h1-1">Hoi @_naam</h1>

<section class="section-1">
<div class="div-2">Afbeelding: Mars</div>
<div class="div-3">
<span class="span-1">Volgende reis · nog [X] dagen</span>
<h2 class="h2-1">Mars Basecamp Expeditie</h2>
<span class="span-2">[DATUM] – [DATUM] · Raket · 2 reizigers · [VV-000000]</span>
<div class="div-4">
<a href="/reis" class="a-2">Bekijk details</a>
</div>
</div>
</section>

<section class="section-2">
<h2 class="h2-2">Mijn boekingen</h2>
<div class="div-5">
<table class="table-1">
<thead><tr class="tr-1"><th class="th-1">Boeking</th><th class="th-1">Reis</th><th class="th-1">Vertrek</th><th class="th-1">Status</th><th class="th-1">Betaling</th></tr></thead>
<tbody>
@foreach (var b in Boekingen) {
<tr class="tr-2"><td class="th-1">@(b.Nr)</td><td class="td-1">@(b.Reis)</td><td class="th-1">@(b.Datum)</td><td class="th-1">@(b.Status)</td><td class="th-1">@(b.Betaling)</td></tr>
}
</tbody>
</table>
</div>
</section>

<div class="div-6">
<section class="section-3">
<h2 class="h2-3">Openstaande offerte</h2>
<p class="p-1">Saturnus Ringencruise · 2 pers.</p>
<p class="p-2">Prijs geldig tot [DATUM]</p>
<a href="/boeken/samenstellen" class="a-3">Offerte boeken</a>
</section>
<section class="section-3">
<h2 class="h2-3">Mijn vragen</h2>
<p class="p-1">#[TICKET] Bagagelimiet raket</p>
<p class="p-3">In behandeling · antwoord binnen [X] uur</p>
</section>
</div>

<section class="section-2">
<h2 class="h2-2">Aanbevolen voor jou</h2>
<p class="p-4">Op basis van je eerdere reizen en voorkeuren.</p>
<div class="div-7">
<a href="/reis" class="a-4"><div class="div-8"></div><strong>[Aanbeveling 1]</strong><p class="p-5">vanaf [PRIJS]</p></a>
<a href="/reis" class="a-4"><div class="div-8"></div><strong>[Aanbeveling 2]</strong><p class="p-5">vanaf [PRIJS]</p></a>
<a href="/reis" class="a-4"><div class="div-8"></div><strong>[Aanbeveling 3]</strong><p class="p-5">vanaf [PRIJS]</p></a>
</div>
</section>
</div>
</main>


@inject AuthenticationStateProvider AuthStateProvider

@code {
    private string _naam = "";

    protected override async Task OnInitializedAsync() =>
        _naam = (await AuthStateProvider.GetAuthenticationStateAsync()).User.FindFirst(System.Security.Claims.ClaimTypes.GivenName)?.Value ?? "";

    private record BoekingenItem(string Nr, string Reis, string Datum, string Status, string Betaling);

    private static readonly BoekingenItem[] Boekingen =
    [
        new("[VV-000000]", "Mars Basecamp Expeditie", "[DATUM]", "Bevestigd", "Betaald"),
        new("[VV-000001]", "Pluto VR Experience", "[DATUM]", "Bevestigd", "Aanbetaald"),
        new("[VV-000002]", "Venus Wolkenstad Weekend", "[DATUM]", "Afgerond", "Betaald"),
    ];

}
