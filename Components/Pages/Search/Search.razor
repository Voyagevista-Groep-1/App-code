@page "/bestemmingen"

<PageTitle>VoyageVista – Zoekresultaten</PageTitle>

<SiteHeader Active="true" />

<div style="background: var(--surface)">
<div style="max-width: 1280px; margin: 0 auto; padding: 16px 32px; display: flex; flex-wrap: wrap; gap: 12px; align-items: center; font-size: 14px">
<span style="color: var(--muted)">Je zoekt:</span>
<span style="background: var(--white); border: 1px solid var(--border); border-radius: 999px; padding: 8px 14px">@(Planeet.Length == 0 ? "Alle planeten" : string.Join(", ", Planeet))</span>
<span style="background: var(--white); border: 1px solid var(--border); border-radius: 999px; padding: 8px 14px">@(string.IsNullOrEmpty(Datum) ? "Alle data" : Datum)</span>
<span style="background: var(--white); border: 1px solid var(--border); border-radius: 999px; padding: 8px 14px">@(Reizigers) reizigers</span>
<span style="background: var(--white); border: 1px solid var(--border); border-radius: 999px; padding: 8px 14px">@(Vorm.Length == 0 ? "Alle reisvormen" : string.Join(", ", Vorm))</span>
<a href="/" style="font-weight: 600; padding: 8px">Zoekopdracht wijzigen</a>
</div>
</div>

<main style="max-width: 1280px; margin: 0 auto; padding: 32px; display: flex; flex-wrap: wrap; gap: 32px; align-items: flex-start">

<form method="get" action="/bestemmingen" aria-label="Filters" style="flex: 1 1 260px; max-width: 300px; border: 1px solid var(--line); border-radius: 16px; padding: 20px; display: flex; flex-direction: column; gap: 22px">
<div style="display: flex; justify-content: space-between; align-items: center">
<h2 style="margin: 0; font-size: 18px">Filters</h2>
<a href="/bestemmingen" style="font-weight: 600; font-size: 14px; padding: 8px">Wis alles</a>
</div>
<input type="hidden" name="datum" value="@Datum">
<input type="hidden" name="reizigers" value="@Reizigers">
<fieldset style="border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px">
<legend style="font-weight: 700; font-size: 14px; margin-bottom: 8px">Bestemming</legend>
@foreach (var o in AllePlaneten) {
<label style="display: flex; gap: 10px; align-items: center"><input type="checkbox" name="planeet" value="@o" checked="@(Gekozen(Planeet, o))"> @o</label>
}
</fieldset>
<fieldset style="border: 0; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; font-size: 15px">
<legend style="font-weight: 700; font-size: 14px; margin-bottom: 8px">Reisvorm</legend>
@foreach (var o in AlleVormen) {
<label style="display: flex; gap: 10px; align-items: center"><input type="checkbox" name="vorm" value="@o" checked="@(Gekozen(Vorm, o))"> @o</label>
}
</fieldset>
<button type="submit" class="btn btn--primary">Filters toepassen</button>
</form>

<section style="flex: 999 1 560px; min-width: 0; display: flex; flex-direction: column; gap: 20px">
<div style="display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 12px">
<h1 style="margin: 0; font-family: 'Space Grotesk', sans-serif; font-size: 28px">@Resultaten.Count @(Resultaten.Count == 1 ? "reis" : "reizen") gevonden</h1>

</div>

@foreach (var r in Resultaten) {
<article style="border: 1px solid var(--line); border-radius: 16px; overflow: hidden; display: flex; flex-wrap: wrap">
<div style="flex: 1 1 240px; min-height: 180px; background: var(--surface); display: flex; align-items: center; justify-content: center; color: var(--muted); font-size: 14px">Afbeelding: @(r.Planeet)</div>
<div style="flex: 2 1 320px; padding: 20px; display: flex; flex-direction: column; gap: 10px">
<div style="display: flex; flex-wrap: wrap; gap: 8px; font-size: 12px; font-weight: 600">
<span style="background: var(--brand-tint); color: var(--brand-dark); padding: 4px 10px; border-radius: 999px">@(r.Planeet)</span>
<span style="background: var(--info-bg); color: var(--info); padding: 4px 10px; border-radius: 999px">@(r.Vorm)</span>
<span style="background: var(--surface-2); color: var(--text-2); padding: 4px 10px; border-radius: 999px">@(r.Duur)</span>
</div>
<h2 style="margin: 0; font-size: 20px">@(r.Titel)</h2>
<p style="margin: 0; color: var(--muted); font-size: 14px; line-height: 1.5">[Korte productomschrijving uit gestandaardiseerde productdata]</p>
<span style="font-size: 13px; font-weight: 600; color: var(--success)">@(r.Status)</span>
</div>
<div style="flex: 1 1 200px; padding: 20px; border-left: 1px solid var(--line); display: flex; flex-direction: column; justify-content: center; gap: 10px">
<span style="font-size: 13px; color: var(--muted)">vanaf</span>
<span style="font-family: 'Space Grotesk', sans-serif; font-size: 26px; font-weight: 700">[PRIJS]</span>
<span style="font-size: 12px; color: var(--muted)">p.p., actueel bijgewerkt</span>
<a href="/reis" style="background: var(--brand); color: var(--white); text-decoration: none; text-align: center; padding: 12px; border-radius: 10px; font-weight: 600">Bekijk reis</a>
</div>
</article>
}

<div style="background: var(--surface); border-radius: 16px; padding: 20px; display: flex; flex-wrap: wrap; gap: 16px; align-items: center; justify-content: space-between">
<div>
<p style="margin: 0; font-weight: 700">Niet gevonden wat je zoekt?</p>
<p style="margin: 4px 0 0; font-size: 14px; color: var(--text-2)">Bekijk alternatieven: andere data, reisvorm of vergelijkbare bestemming.</p>
</div>
<a href="/bestemmingen" style="border: 1px solid var(--brand); color: var(--brand); text-decoration: none; padding: 12px 18px; border-radius: 10px; font-weight: 600">Toon alternatieven</a>
</div>
</section>
</main>


@code {
    [SupplyParameterFromQuery(Name = "planeet")] private string[] Planeet { get; set; } = [];
    [SupplyParameterFromQuery(Name = "vorm")] private string[] Vorm { get; set; } = [];
    [SupplyParameterFromQuery(Name = "datum")] private string? Datum { get; set; }
    [SupplyParameterFromQuery(Name = "reizigers")] private int Reizigers { get; set; } = 2;

    private static readonly string[] AllePlaneten = ["Mars", "Saturnus", "Pluto", "Venus"];
    private static readonly string[] AlleVormen = ["Raket", "Teleportatie", "Vliegend cruiseschip", "Virtual Reality Experience"];

    private static bool Gekozen(string[] gekozen, string o) => gekozen.Contains(o);

    private List<ReizenItem> Resultaten => Reizen
        .Where(r => (Planeet.Length == 0 || Planeet.Contains(r.Planeet)) && (Vorm.Length == 0 || Vorm.Contains(r.Vorm)))
        .ToList();

    private record ReizenItem(string Titel, string Planeet, string Vorm, string Duur, string Status);

    private static readonly ReizenItem[] Reizen =
    [
        new("Mars Basecamp Expeditie", "Mars", "Raket", "7 dagen", "Beschikbaar"),
        new("Saturnus Ringencruise", "Saturnus", "Vliegend cruiseschip", "12 dagen", "Nog [X] plekken"),
        new("Venus Wolkenstad Weekend", "Venus", "Teleportatie", "3 dagen", "Beschikbaar"),
        new("Pluto IJsvlakte Experience", "Pluto", "Virtual Reality Experience", "Dagtrip", "Beschikbaar"),
    ];

}
