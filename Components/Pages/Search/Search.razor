@page "/bestemmingen"

<PageTitle>VoyageVista – Zoekresultaten</PageTitle>

<SiteHeader Active="true" />

<div class="div-1">
<div class="div-2">
<span class="span-1">Je zoekt:</span>
<span class="span-2">@(Planeet.Length == 0 ? "Alle planeten" : string.Join(", ", Planeet))</span>
<span class="span-2">@(string.IsNullOrEmpty(Datum) ? "Alle data" : Datum)</span>
<span class="span-2">@(Reizigers) reizigers</span>
<span class="span-2">@(Vorm.Length == 0 ? "Alle reisvormen" : string.Join(", ", Vorm))</span>
<a href="/" class="a-1">Zoekopdracht wijzigen</a>
</div>
</div>

<main class="main-1">

<form method="get" action="/bestemmingen" aria-label="Filters" class="form-1">
<div class="div-3">
<h2 class="h2-1">Filters</h2>
<a href="/bestemmingen" class="a-2">Wis alles</a>
</div>
<input type="hidden" name="datum" value="@Datum">
<input type="hidden" name="reizigers" value="@Reizigers">
<fieldset class="fieldset-1">
<legend class="legend-1">Bestemming</legend>
@foreach (var o in AllePlaneten) {
<label class="label-1"><input type="checkbox" name="planeet" value="@o" checked="@(Gekozen(Planeet, o))"> @o</label>
}
</fieldset>
<fieldset class="fieldset-1">
<legend class="legend-1">Reisvorm</legend>
@foreach (var o in AlleVormen) {
<label class="label-1"><input type="checkbox" name="vorm" value="@o" checked="@(Gekozen(Vorm, o))"> @o</label>
}
</fieldset>
<button type="submit" class="btn btn--primary">Filters toepassen</button>
</form>

<section class="section-1">
<div class="div-4">
<h1 class="h1-1">@Resultaten.Count @(Resultaten.Count == 1 ? "reis" : "reizen") gevonden</h1>

</div>

@foreach (var r in Resultaten) {
<article class="article-1">
<div class="div-5">Afbeelding: @(r.Planeet)</div>
<div class="div-6">
<div class="div-7">
<span class="span-3">@(r.Planeet)</span>
<span class="span-4">@(r.Vorm)</span>
<span class="span-5">@(r.Duur)</span>
</div>
<h2 class="h2-2">@(r.Titel)</h2>
<p class="p-1">[Korte productomschrijving uit gestandaardiseerde productdata]</p>
<span class="span-6">@(r.Status)</span>
</div>
<div class="div-8">
<span class="span-7">vanaf</span>
<span class="span-8">[PRIJS]</span>
<span class="span-9">p.p., actueel bijgewerkt</span>
<a href="/reis" class="a-3">Bekijk reis</a>
</div>
</article>
}

<div class="div-9">
<div>
<p class="p-2">Niet gevonden wat je zoekt?</p>
<p class="p-3">Bekijk alternatieven: andere data, reisvorm of vergelijkbare bestemming.</p>
</div>
<a href="/bestemmingen" class="a-4">Toon alternatieven</a>
</div>
</section>
</main>


@code {
    [SupplyParameterFromQuery(Name = "planeet")] private string[] Planeet { get; set; } = [];
    [SupplyParameterFromQuery(Name = "vorm")] private string[] Vorm { get; set; } = [];
    [SupplyParameterFromQuery(Name = "datum")] private string? Datum { get; set; }
    [SupplyParameterFromQuery(Name = "reizigers")] private int Reizigers { get; set; } = 2;

    private static readonly string[] AllePlaneten = ["Mars", "Saturnus", "Pluto", "Venus"];
    private static readonly string[] AlleVormen = ["Raket", "Teleportatie", "Vliegend cruiseschip", "Virtual Reality Experience"];

    private static bool Gekozen(string[] gekozen, string o) => gekozen.Contains(o);

    private List<ReizenItem> Resultaten => Reizen
        .Where(r => (Planeet.Length == 0 || Planeet.Contains(r.Planeet)) && (Vorm.Length == 0 || Vorm.Contains(r.Vorm)))
        .ToList();

    private record ReizenItem(string Titel, string Planeet, string Vorm, string Duur, string Status);

    private static readonly ReizenItem[] Reizen =
    [
        new("Mars Basecamp Expeditie", "Mars", "Raket", "7 dagen", "Beschikbaar"),
        new("Saturnus Ringencruise", "Saturnus", "Vliegend cruiseschip", "12 dagen", "Nog [X] plekken"),
        new("Venus Wolkenstad Weekend", "Venus", "Teleportatie", "3 dagen", "Beschikbaar"),
        new("Pluto IJsvlakte Experience", "Pluto", "Virtual Reality Experience", "Dagtrip", "Beschikbaar"),
    ];

}
